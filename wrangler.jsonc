{
	"$schema": "node_modules/wrangler/config-schema.json",
	"assets": {
		"directory": "./dist/client",
	},
	"compatibility_date": "2026-10-12",
	"name": "slowp-ke",
	"preview_urls": false,
	"routes": [
		{
			"custom_domain": true,
			"enabled": true,
			"pattern": "slowp.ke",
			"previews_enabled": false,
		},
	],
}
